# ─────────────────────────────────────────────
# Backend Configuration
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# Database (SQLite)
# ─────────────────────────────────────────────
DATABASE_PATH=./data/rag.db
DATABASE_TIMEOUT_MS=5000

# ─────────────────────────────────────────────
# Ollama (Local LLM)
# ─────────────────────────────────────────────
# Install: https://ollama.ai
# Run: ollama pull mistral && ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=60000
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
OLLAMA_MAX_TOKENS=512

# ─────────────────────────────────────────────
# ChromaDB (Vector Store)
# ─────────────────────────────────────────────
# Install: pip install chromadb && chroma run --path ./data/chroma
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_PERSIST_DIRECTORY=./data/chroma
CHROMADB_COLLECTION_NAME=website_chunks

# ─────────────────────────────────────────────
# Scraper Configuration
# ─────────────────────────────────────────────
SCRAPER_REQUEST_DELAY_MS=2000
SCRAPER_REQUEST_TIMEOUT_MS=30000
SCRAPER_MAX_CONCURRENT=2
SCRAPER_MAX_PAGES_PER_DOMAIN=50
SCRAPER_MAX_RETRIES=3
SCRAPER_RESPECT_ROBOTS_TXT=true
SCRAPER_USER_AGENT=RAGBot/1.0 (Learning Project)

# ─────────────────────────────────────────────
# RAG Configuration
# ─────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=100
RAG_SIMILARITY_THRESHOLD=0.6
RAG_N_RESULTS=5
RAG_MAX_HISTORY=10

# ─────────────────────────────────────────────
# Frontend (Vite reads VITE_ prefix)
# ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SCRAPE_POLL_INTERVAL_MS=2000

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_FORMAT=pretty
LOG_FILE=./logs/app.log
